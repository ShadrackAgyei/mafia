{
  "name": "mafia-game",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "setup": "npm install && docker-compose up -d && cd server && npx prisma generate && npx prisma migrate dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
